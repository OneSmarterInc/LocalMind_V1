# =============================================================================
# LocalMind production configuration (AWS, one Linux server, Docker Compose)
#
# Starting point for every deployment. Copy it and fill in the CHANGE_ME values:
#   AWS EC2 / Docker Compose:  cp backend/.env.example deploy/.env
#   Bare-metal Linux server:   cp backend/.env.example backend/.env
# The laptop launcher (run_localmind.py) writes its own backend/.env instead.
# NEVER commit the copy. NEVER paste it into chat, email or Slack.
# See docs/AWS_EC2_RUNBOOK.md and docs/ENVIRONMENT.md.
#
# Every line marked  >>> FILL IN  must be changed before first start.
# Generate each secret on the server with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# >>> FILL IN: a brand-new value. Do NOT reuse the laptop key (it was shared).
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_new_one

DJANGO_DEBUG=false

# >>> FILL IN: your real domain. No "*" in production.
DJANGO_ALLOWED_HOSTS=localmind.onesmarter.com

# The web client is served by the same server (same origin), so CORS is only
# needed if you later host the website somewhere else (for example Vercel).
DJANGO_CORS_ALLOWED_ORIGINS=https://localmind.onesmarter.com

# >>> FILL IN: same domain, with https://
DJANGO_CSRF_TRUSTED_ORIGINS=https://localmind.onesmarter.com

LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Database (PostgreSQL runs in Docker on the same server)
# docker-compose.yml builds DATABASE_URL from this password. Do not set
# DATABASE_URL yourself. The laptop SQLite lines are removed on purpose.
# -----------------------------------------------------------------------------

# >>> FILL IN: a long random password (letters and digits only is safest).
POSTGRES_PASSWORD=CHANGE_ME_long_random_password


# -----------------------------------------------------------------------------
# Files and uploads
# MEDIA_ROOT and WEB_DIST are set inside docker-compose.yml. The Windows
# paths from the laptop file are removed on purpose.
# -----------------------------------------------------------------------------

MAX_UPLOAD_MB=100
SERVE_WEB=true
SERVE_MEDIA=true
PROCESS_DOCUMENTS_INLINE=false
PROCESSING_STALE_MINUTES=30


# -----------------------------------------------------------------------------
# Accounts, sign-in and sessions
# -----------------------------------------------------------------------------

# First admin, created only when the database is empty.
# >>> FILL IN: the real admin email.
BOOTSTRAP_ADMIN_EMAIL=admin@onesmarter.com

INITIAL_PASSWORD_MODE=shared
# >>> FILL IN: a NEW shared first-login password. The old one is printed in
# the public README, so anyone could use it.
INITIAL_USER_PASSWORD=CHANGE_ME_new_first_login_password

LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# Back to normal production values (the laptop used 180 for tester comfort).
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
SESSION_HEARTBEAT_TIMEOUT_MINUTES=10

# One proxy (Caddy) sits in front of Django. docker-compose.yml also sets this.
TRUSTED_PROXY_COUNT=1


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
TRUST_PROXY_SSL_HEADER=true

# Caddy already redirects http to https. Keep this false to avoid a loop.
SECURE_SSL_REDIRECT=false

# Leave 0 for the first week. Once https has worked for a week, set 31536000.
SECURE_HSTS_SECONDS=0

API_DOCS_ENABLED=false


# -----------------------------------------------------------------------------
# Learning rules (unchanged from the laptop)
# -----------------------------------------------------------------------------

FACULTY_CAN_PUBLISH=true
DEFAULT_PASS_PERCENTAGE=65
MAX_QUIZ_DURATION_HOURS=6


# -----------------------------------------------------------------------------
# AI model on the server (embedded llama.cpp)
# Copy backend/models (the .gguf file and the docling folder) from the laptop
# to the server's LocalMind_V1/backend/models before first start.
# -----------------------------------------------------------------------------

AI_ENABLED=true
AI_PROVIDER=llamacpp
AI_MODEL_FILE=Qwen3-1.7B-Q4_K_M.gguf
AI_MODEL_REPO=unsloth/Qwen3-1.7B-GGUF

# CHANGED: must match the server's vCPU count (4 on a t3a.xlarge EC2
# server). The laptop value of 8 would make every answer slower here.
AI_THREADS=4
AI_BATCH=512
AI_GPU_LAYERS=0
AI_LOAD_RETRY_SECONDS=60
AI_HEALTH_CACHE_SECONDS=30

AI_PERFORMANCE_MODE=fast

# CHANGED: raised from 90. The 90 was only there because of Cloudflare's
# 100-second limit. Caddy has no such limit.
OLLAMA_TIMEOUT_SECONDS=150

OLLAMA_NUM_PREDICT=4096
OLLAMA_MAX_RETRIES=1
AI_TUTOR_MAX_TOKENS=350

# CHANGED: on. The models are copied in, so nothing should reach Hugging Face.
HF_HUB_OFFLINE=1


# -----------------------------------------------------------------------------
# Background work
# -----------------------------------------------------------------------------

LESSON_AUTO_GENERATE=false
LESSON_MAX_ATTEMPTS=3
LESSON_RETRY_MINUTES=10
LESSON_STALE_MINUTES=15
LESSON_WORKER_IDLE_SECONDS=30

DURABLE_JOBS=true
JOB_LEASE_SECONDS=300


# -----------------------------------------------------------------------------
# Tidying new books (unchanged)
# -----------------------------------------------------------------------------

OUTLINE_MERGE_SMALL=true
OUTLINE_MERGE_MIN_CHARS=500
OUTLINE_MERGE_MAX_CHARS=16000
OUTLINE_MIN_MODULE_WORDS=220
OUTLINE_MAX_MODULE_WORDS=1500


# -----------------------------------------------------------------------------
# Automatic module quizzes (unchanged, MCQ only)
# -----------------------------------------------------------------------------

AUTO_QUIZ_ENABLED=true
AUTO_QUIZ_MCQS=5
AUTO_QUIZ_SUBJECTIVE=0
AUTO_QUIZ_PASS_PERCENTAGE=65
AUTO_QUIZ_MAX_ATTEMPTS=3
AUTO_QUIZ_MIN_CHARS=500


# -----------------------------------------------------------------------------
# AI Monitoring & Guard (unchanged; the 7B judge stays off to save RAM)
# -----------------------------------------------------------------------------

AI_MONITOR_ENABLED=true
AI_MONITOR_MODE=async
AI_MONITOR_JUDGE_ENABLED=true
AI_MONITOR_SAMPLE_PERCENT=5
AI_MONITOR_MIN_JUDGE_CONFIDENCE=60
AI_MONITOR_MAX_EVIDENCE_CHARS=2500
AI_MONITOR_EVIDENCE_CHUNKS=2
AI_MONITOR_RETENTION_DAYS=180
AI_MONITOR_EVALUATOR_VERSION=1.1


# -----------------------------------------------------------------------------
# Offline-study signing key
# CHANGED: a NEW key for production, stored on the server, mounted into the
# container at /app/keys. The laptop test key stays on the laptop.
# Create it once on the server (docs/AWS_EC2_RUNBOOK.md, step 7):
#   python manage.py study_signing_key /app/keys/publisher.pem --key-id localmind-prod-1
# -----------------------------------------------------------------------------

STUDY_SIGNING_KEY_PATH=/app/keys/publisher.pem
STUDY_SIGNING_KEY_ID=localmind-prod-1
STUDY_OBSERVATIONS_ENABLED=false
STUDY_MIN_AGGREGATE_EVENTS=5


# -----------------------------------------------------------------------------
# Device authoring (unchanged): lessons and quizzes are generated in each
# user's browser or phone, not on the server. This keeps the server small.
# -----------------------------------------------------------------------------

DEVICE_AUTHORING_ONLY=true
