{
  "name": "localmind-client",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "export:web": "expo export --platform web",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:all": "eas build --platform all --profile production",
    "prebuild": "expo prebuild --clean",
    "doctor": "npx expo-doctor",
    "prepare:private": "node scripts/prepare-private-assets.mjs",
    "postinstall": "npm run prepare:private",
    "prestart": "npm run prepare:private",
    "preweb": "npm run prepare:private",
    "preandroid": "npm run prepare:private",
    "preios": "npm run prepare:private",
    "preexport:web": "npm run prepare:private",
    "postexport:web": "node scripts/build-offline-manifest.mjs",
    "test:private": "node ../tests/private-contracts.mjs",
    "test:private:web": "playwright test -c tests/private.playwright.config.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.9",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "@noble/hashes": "1.8.0",
    "@wllama/wllama": "3.6.1",
    "@wllama/wllama-compat": "3.6.1",
    "base64-js": "1.5.1",
    "expo-crypto": "~15.0.8",
    "expo-file-system": "~19.0.24",
    "expo-sqlite": "~16.0.10",
    "fflate": "0.8.3",
    "llama.rn": "0.10.0",
    "pdfjs-dist": "4.10.38",
    "react-native-webview": "13.15.0",
    "tesseract.js": "6.0.1",
    "@tesseract.js-data/eng": "1.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "esbuild": "0.25.9",
    "@playwright/test": "1.55.1"
  },
  "private": true
