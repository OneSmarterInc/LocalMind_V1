# Replace the domain with yours. Caddy fetches and renews the https
# certificate on its own; ports 80 and 443 must be open to the internet.
localmind.onesmarter.com {
	request_body {
		max_size 100MB
	}
	encode gzip
	reverse_proxy api:8000 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
